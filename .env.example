# ── WAHA (the only bridge provider) ─────────────────────────────────────────
# Any string — WAHA just needs *a* key configured, it doesn't issue one.
WAHA_API_KEY=
WAHA_SESSION=default
# devlikeapro/waha:latest has no arm64 build as of this writing, and the
# stable `arm` tag (2026.8.2) has a QR-pairing-breaking bug that `dev-arm`
# (2026.9.1) doesn't. docker-compose.yml already defaults to `dev-arm`;
# uncomment to target a different platform/tag once a stable release picks
# up the fix.
# WAHA_IMAGE=devlikeapro/waha:latest

# ── MCP server ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── MCP server auth (WorkOS AuthKit) ────────────────────────────────────────
# WorkOS Dashboard → Applications → Configuration → enable "Dynamic Client
# Registration". Add this server's URL to the Redirects tab, e.g.
# <MCP_BASE_URL>/oauth2/callback. Your AuthKit domain, e.g.
# "https://your-app.authkit.app" — the scheme is required: AuthKitProvider
# validates this as a full URL and crashes at startup on a bare domain
# (confirmed against a real deploy).
WORKOS_AUTHKIT_DOMAIN=
# The MCP server's own public URL once deployed; http://localhost:8000 for
# local dev.
MCP_BASE_URL=http://localhost:8000
# Comma-separated allowlist of account emails permitted to call any
# tool at all. Everyone else gets AuthorizationError.
ALLOWED_EMAILS=

# Local dev only — skips AuthKit login entirely so you don't need a real
# WorkOS project just to run the stack locally. Outbound/write tools stay
# blocked either way — this only removes the login requirement. Leave
# unset/false anywhere this server might be reachable by anyone but you.
# LOCAL_DEV_DISABLE_AUTH=true

# Optional. Enables get_media() to attach a transcript alongside a voice
# note's audio — otherwise the audio is still returned, just without one.
# Sends the audio bytes to OpenAI's transcription API; leave unset if
# that's not acceptable for this deployment. See
# docs/decisions/0014-openai-whisper-api-for-voice-transcription.md.
# OPENAI_API_KEY=sk-...

# ── Integration test only — NOT required by the MCP server at runtime ─────────
# ANTHROPIC_API_KEY=sk-...
