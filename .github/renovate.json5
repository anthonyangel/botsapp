// Renovate config — see docs/decisions/0020-renovate-dependency-management.md.
// Run by .github/workflows/renovate.yml (self-hosted); the Dependency
// Dashboard is the issue Renovate maintains on this repo.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended", // includes the dependency dashboard
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitsDisabled",
  ],

  dependencyDashboard: true,
  dependencyDashboardTitle: "Dependency Dashboard",
  dependencyDashboardAutoclose: false,

  labels: ["dependencies"],
  timezone: "Etc/UTC",
  // Weekly batch keeps PR noise down; security updates ignore this schedule.
  schedule: ["before 6am on monday"],
  prConcurrentLimit: 5,
  prHourlyLimit: 4,
  rebaseWhen: "conflicted",

  // Renovate exits non-zero only for error-level log entries, and its failures to
  // write (dashboard issue, branches, PRs) are logged as warnings — so a run that
  // couldn't change anything exits 0. Promote those to errors so the CI job fails.
  // See docs/decisions/0021-renovate-token-fallback.md.
  logLevelRemap: [
    {
      matchMessage: "/^(Could not ensure issue|Error updating branch|Error updating PR|Error ensuring comment)/",
      newLogLevel: "error",
    },
  ],

  // Advisories from OSV (covers PyPI) as well as GitHub's own.
  vulnerabilityAlerts: { enabled: true, labels: ["dependencies", "security"], schedule: ["at any time"] },
  osvVulnerabilityAlerts: true,

  // Monthly refresh of transitive pins only. Direct dependencies arrive through
  // the grouped weekly PR below, so the two don't produce overlapping PRs.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on the first day of the month"],
  },

  // Keep the ">=" floors in pyproject.toml in step with what uv.lock resolves,
  // so a minor/patch bump shows up as a pyproject.toml change, not a silent
  // lockfile-only change.
  pep621: { rangeStrategy: "bump" },

  customManagers: [
    {
      // `image = "devlikeapro/waha:dev"` in waha/fly.toml (no built-in Fly manager).
      // The whole match is what gets replaced, so autoReplaceStringTemplate must
      // rebuild the full `image = "..."` text — without it Renovate can't add a
      // pinned digest and fails with "update failure". currentDigest is captured
      // so later digest bumps work too.
      // (docker-compose.yml's `${WAHA_IMAGE:-devlikeapro/waha:dev-arm}` default is
      // deliberately NOT tracked: it's a local arm64 dev tag, and Handlebars can't
      // express the closing `}` after the optional digest.)
      customType: "regex",
      managerFilePatterns: ["/(^|/)waha/fly\\.toml$/"],
      matchStrings: [
        'image\\s*=\\s*"(?<depName>[^":@\\s]+):(?<currentValue>[^"@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"',
      ],
      autoReplaceStringTemplate:
        'image = "{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"',
      datasourceTemplate: "docker",
    },
  ],

  // Later rules win, so the specific ones (MCP, Python, WAHA) come after the
  // general groups.
  packageRules: [
    {
      description: "GitHub Actions: one PR for all action bumps",
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
      addLabels: ["ci"],
    },
    {
      description: "Python: minor and patch updates, runtime and dev tooling, in ONE PR",
      matchManagers: ["pep621"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Python dependencies",
      addLabels: ["python"],
    },
    {
      description: "Python: majors get their own PR each (never batched)",
      matchManagers: ["pep621"],
      matchUpdateTypes: ["major"],
      addLabels: ["python"],
    },
    {
      description: "MCP stack: every bump is reviewed on its own, it defines the public protocol surface",
      matchPackageNames: ["fastmcp", "mcp"],
      groupName: "MCP stack",
      addLabels: ["mcp"],
      automerge: false,
    },
    {
      description: "Python interpreter: never propose a new minor/major — Dockerfile, .python-version, requires-python and [tool.ty] change together, by hand, after checking dependencies support it (3.15 breaks today: beartype imports typing.no_type_check_decorator)",
      matchPackageNames: ["python"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
    {
      description: "Container base images (python, uv): one PR for digest/patch refreshes",
      matchManagers: ["dockerfile"],
      groupName: "Docker base images",
      addLabels: ["docker"],
    },
    {
      description: "WAHA: moving tags and engine changes have broken the mapper before — never automerge",
      matchPackageNames: ["devlikeapro/waha"],
      groupName: "WAHA",
      addLabels: ["docker", "waha"],
      automerge: false,
      // The `dev` tag only ever produces digest updates; hold them for a dashboard tick.
      dependencyDashboardApproval: true,
    },
  ],
}
